function handler(event) {
    var request = event.request;
    var query = [];
    Object.keys(request.querystring).forEach(function (key) {
        var parameter = request.querystring[key];
        var values = parameter.multiValue || [parameter];
        values.forEach(function (item) {
            // CloudFront supplies URL-encoded values. Do not double-encode them.
            query.push(key + '=' + item.value);
        });
    });
    return {
        statusCode: 301,
        statusDescription: 'Moved Permanently',
        headers: {
            location: { value: 'https://${canonical_hostname}' + request.uri +
                (query.length ? '?' + query.join('&') : '') },
            'cache-control': { value: 'public,max-age=300' }
        }
    };
}
